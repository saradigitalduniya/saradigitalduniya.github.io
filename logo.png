<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 200 200">
  <defs>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1E40AF" />
      <stop offset="50%" stop-color="#1D4ED8" />
      <stop offset="100%" stop-color="#0F172A" />
    </linearGradient>
    <linearGradient id="amberGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F97316" />
      <stop offset="100%" stop-color="#F59E0B" />
    </linearGradient>
  </defs>
  <!-- Outer Ring -->
  <circle cx="100" cy="100" r="96" fill="url(#blueGrad)" stroke="url(#amberGrad)" stroke-width="6"/>
  <circle cx="100" cy="100" r="88" fill="none" stroke="#3B82F6" stroke-width="1.5" stroke-dasharray="8,4"/>
  
  <!-- Icon Graphics -->
  <path d="M70 65 L130 65 L145 95 L55 95 Z" fill="url(#amberGrad)" opacity="0.9"/>
  <path d="M60 102 L140 102 L130 135 L70 135 Z" fill="#ffffff" opacity="0.95"/>
  <circle cx="100" cy="100" r="16" fill="#1E40AF" stroke="#F97316" stroke-width="3"/>
  <path d="M93 100 L107 100 M100 93 L100 107" stroke="#F59E0B" stroke-width="3" stroke-linecap="round"/>

  <!-- Brand Initials & Curves -->
  <text x="100" y="158" text-anchor="middle" fill="#FFFFFF" font-family="'Arial', sans-serif" font-weight="900" font-size="14" letter-spacing="1">SARA DIGITAL</text>
  <text x="100" y="173" text-anchor="middle" fill="#F97316" font-family="'Arial', sans-serif" font-weight="800" font-size="11" letter-spacing="0.5">DUNIYA</text>
</svg>