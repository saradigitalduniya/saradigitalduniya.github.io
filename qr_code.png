<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 300 300">
  <defs>
    <linearGradient id="qrGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0284C7" />
      <stop offset="100%" stop-color="#1E40AF" />
    </linearGradient>
  </defs>
  <rect width="300" height="300" fill="#FFFFFF" rx="20"/>
  <rect x="15" y="15" width="270" height="270" fill="none" stroke="#E2E8F0" stroke-width="3" rx="12"/>
  
  <!-- Outer Position Detection Patterns -->
  <!-- Top Left -->
  <rect x="35" y="35" width="60" height="60" fill="#1E40AF" rx="8"/>
  <rect x="45" y="45" width="40" height="40" fill="#FFFFFF" rx="4"/>
  <rect x="53" y="53" width="24" height="24" fill="#F97316" rx="2"/>

  <!-- Top Right -->
  <rect x="205" y="35" width="60" height="60" fill="#1E40AF" rx="8"/>
  <rect x="215" y="45" width="40" height="40" fill="#FFFFFF" rx="4"/>
  <rect x="223" y="53" width="24" height="24" fill="#F97316" rx="2"/>

  <!-- Bottom Left -->
  <rect x="35" y="205" width="60" height="60" fill="#1E40AF" rx="8"/>
  <rect x="45" y="215" width="40" height="40" fill="#FFFFFF" rx="4"/>
  <rect x="53" y="223" width="24" height="24" fill="#F97316" rx="2"/>

  <!-- Simulated QR Code Grid Modules -->
  <rect x="110" y="35" width="16" height="16" fill="#0F172A"/>
  <rect x="135" y="35" width="16" height="32" fill="#0F172A"/>
  <rect x="160" y="35" width="30" height="16" fill="#0F172A"/>
  
  <rect x="110" y="60" width="32" height="16" fill="#0F172A"/>
  <rect x="150" y="60" width="16" height="16" fill="#F97316"/>
  <rect x="175" y="60" width="16" height="32" fill="#0F172A"/>

  <rect x="35" y="110" width="16" height="32" fill="#0F172A"/>
  <rect x="60" y="110" width="32" height="16" fill="#0F172A"/>

  <!-- Center Branding Logo Badge -->
  <rect x="110" y="110" width="80" height="80" fill="url(#qrGrad)" rx="14" stroke="#FFFFFF" stroke-width="4"/>
  <text x="150" y="148" text-anchor="middle" fill="#FFFFFF" font-family="'Arial', sans-serif" font-weight="900" font-size="22">NAVI</text>
  <text x="150" y="168" text-anchor="middle" fill="#F97316" font-family="'Arial', sans-serif" font-weight="800" font-size="12">UPI PAY</text>

  <rect x="205" y="110" width="32" height="16" fill="#0F172A"/>
  <rect x="245" y="110" width="20" height="32" fill="#0F172A"/>

  <rect x="35" y="150" width="32" height="16" fill="#0F172A"/>
  <rect x="75" y="150" width="20" height="32" fill="#0F172A"/>

  <rect x="205" y="150" width="16" height="32" fill="#0F172A"/>
  <rect x="230" y="150" width="35" height="16" fill="#0F172A"/>

  <rect x="110" y="205" width="35" height="16" fill="#0F172A"/>
  <rect x="155" y="205" width="35" height="35" fill="#0F172A"/>
  <rect x="205" y="205" width="16" height="35" fill="#F97316"/>

  <rect x="110" y="230" width="16" height="35" fill="#0F172A"/>
  <rect x="135" y="250" width="35" height="15" fill="#0F172A"/>
  <rect x="180" y="250" width="40" height="15" fill="#0F172A"/>
  <rect x="230" y="230" width="35" height="35" fill="#0F172A"/>

  <text x="150" y="290" text-anchor="middle" fill="#64748B" font-family="'Arial', sans-serif" font-weight="700" font-size="10">939419533-1@naviaxis • RAKIBUL ALI</text>
</svg>